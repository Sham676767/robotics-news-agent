name: Robotics News Preview

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  preview:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          pip install -r requirements.txt pytest

      - name: Run tests
        run: pytest -q

      - name: Build preview
        run: python -m app.preview

      - name: Save preview
        run: |
          git config --global user.name "robotics-agent"
          git config --global user.email "agent@github.com"
          git add articles/preview.md data/latest_top5.json
          git diff --cached --quiet || git commit -m "Generate robotics news preview"
          git push
