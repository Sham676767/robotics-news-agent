# Copy to .env for local development.
# Never commit .env or real secrets.

APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# OpenRouter / AI
OPENROUTER_API_KEY=
# Fixed low-cost model with structured-output support.
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_ATTEMPTS=4
OPENROUTER_ARTICLE_REPAIR_ATTEMPTS=4
# VK publication
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_PUBLISH_REQUIRED=false
# Keep false until a real draft has passed editorial review.
VK_PUBLISH_ENABLED=false
VK_PUBLISH_TIMEOUT=20
VK_PUBLISH_MAX_ATTEMPTS=3
VK_PUBLISH_RETRY_BASE_SECONDS=2
