# The CLI reads .env in the current project directory. Existing environment wins.
# Docker Compose also loads .env via env_file. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
DRAFTS_DIR=drafts
SCRIPT_CTA=Сохраните ролик и поделитесь им
# script uses two stages with this model: generation and independent source review.
# OPENROUTER_MAX_ATTEMPTS applies separately to each stage.

# Required by collect and script; optional for local draft validation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT=120
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=2
OPENROUTER_RETRY_MAX_SECONDS=20

# Speech generation. Docker Compose passes these values from .env.
TTS_PROVIDER=elevenlabs
TTS_OUTPUT_DIR=audio
TTS_TIMEOUT=120
TTS_MAX_ATTEMPTS=3
TTS_RETRY_BASE_SECONDS=2
TTS_RETRY_MAX_SECONDS=20
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Offline video rendering. FFmpeg needs libx264, AAC and libass; Cyrillic font installed.
RENDER_OUTPUT_DIR=renders
RENDER_TEMPLATE=templates/default.yaml
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Complete pipeline: live or stub. Stub drafts can never be published.
PIPELINE_MODE=live

# Instagram Login by default; facebook supports an existing linked Page setup.
INSTAGRAM_LOGIN=instagram
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Set an API version supported by your Meta application, in vNN.N format.
INSTAGRAM_API_VERSION=
INSTAGRAM_SHARE_TO_FEED=true
INSTAGRAM_TIMEOUT=30
INSTAGRAM_MAX_ATTEMPTS=3
INSTAGRAM_RETRY_BASE_SECONDS=2
INSTAGRAM_RETRY_MAX_SECONDS=60
INSTAGRAM_POLL_INTERVAL_SECONDS=60
INSTAGRAM_POLL_ATTEMPTS=5

# S3-compatible endpoint: R2, B2, Yandex Object Storage, MinIO, etc.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Optional: URL root exposing bucket objects. Empty = presigned GET URL.
S3_PUBLIC_BASE_URL=
S3_PRESIGN_TTL_SECONDS=7200
S3_DELETE_AFTER_PUBLISH=true
S3_ADDRESSING_STYLE=auto

# Optional local MinIO test. Set your own local-only credentials.
MINIO_TEST_USER=
MINIO_TEST_PASSWORD=
