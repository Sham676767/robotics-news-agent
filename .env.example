# Example environment. The Python CLI does not auto-load .env.
# Docker Compose loads .env via env_file. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO
DRAFTS_DIR=drafts
SCRIPT_CTA=Сохраните ролик и поделитесь им
# script uses two stages with this model: generation and independent source review.
# OPENROUTER_MAX_ATTEMPTS applies separately to each stage.

# Required by collect and script; optional for local draft validation.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_TIMEOUT=120
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_RETRY_BASE_SECONDS=2
OPENROUTER_RETRY_MAX_SECONDS=20
