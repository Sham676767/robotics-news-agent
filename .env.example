# Copy to .env for local development.
# Never commit .env or real secrets.

APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# OpenRouter / AI
OPENROUTER_API_KEY=
# Free router for initial testing; set a paid model when the account is funded.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_ATTEMPTS=3
# VK publication
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_PUBLISH_REQUIRED=false
# Keep false until a real draft has passed editorial review.
VK_PUBLISH_ENABLED=false
VK_PUBLISH_TIMEOUT=20
