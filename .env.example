# Copy to .env for local development.
# Never commit .env or real secrets.

APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# OpenRouter / AI
OPENROUTER_API_KEY=
# Set a known model explicitly; avoid the rotating openrouter/free router in production.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# VK publication
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_PUBLISH_REQUIRED=false
VK_PUBLISH_TIMEOUT=20
